# ==============================================================================
# VEGA Environment Variables Configuration
# Copy this file to .env and configure your secret credentials.
# ==============================================================================

# Core Application Settings
DEBUG=True
SECRET_KEY=replace-with-a-very-long-and-secure-random-secret-key-in-production

# Database Configuration (PostgreSQL + PostGIS)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=vega_db
DB_USER=vega_user
DB_PASSWORD=vega_secure_password_2026
DB_HOST=localhost
DB_PORT=5432

# Network & Host Settings
ALLOWED_HOSTS=localhost,127.0.0.1,api.vega.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://vega.example.com

# JWT & Authentication Secrets
JWT_SECRET=replace-with-jwt-secret-key-for-signing-tokens
JWT_ACCESS_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# Object Storage (AWS S3 / Cloudflare R2 / GCS)
STORAGE_BUCKET=vega-media-production
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key
STORAGE_REGION=us-east-1

# Geocoding & Maps (Optional External Maps Provider)
MAPS_API_KEY=your-maps-api-key-if-using-external-geocoder
